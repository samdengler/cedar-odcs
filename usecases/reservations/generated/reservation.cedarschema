entity Role in [Role];
entity User in [Role];
entity Reservation {
  recordLocator: String,
  holderLastName: String
};
entity Contract tags String;

type Presented = {
  locator: String,
  lastName: String
};

action LookupReservation appliesTo {
  principal: [User],
  resource: [Reservation],
  context: {
    presented?: Presented
  }
};

action ReadReservation appliesTo {
  principal: [User],
  resource: [Reservation],
  context: {
    presented?: Presented
  }
};

action ReadReservationField appliesTo {
  principal: [User],
  resource: [Reservation],
  context: {
    presented?: Presented,
    field?: String
  }
};
