// The request leg's verb for reading one order. The response leg
// decides the read with ReadOrder, on the order the API returns.
action LookupOrder appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User
  }
};

action ReadOrder appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User
  }
};

action UpdateOrder appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User,
    input?: {
      customerId?: User
    }
  }
};

action CancelOrder appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User,
    input?: {
      customerId?: User
    }
  }
};

action RefundOrder appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User
  }
};

action ReadOrderField appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User,
    field?: String
  }
};

action UpdateOrderField appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User,
    field?: String,
    input?: {
      customerId?: User
    }
  }
};

entity Collection;

action ListOrders appliesTo {
  principal: [User],
  resource: [Collection],
  context: {
    actingFor?: User
  }
};
