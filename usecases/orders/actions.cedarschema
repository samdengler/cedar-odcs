  context: {
    actingFor?: User
  }
};

action RefundOrder appliesTo {
  principal: [User],
  resource: [Order],
  context: {
    actingFor?: User
  }
};

action ReadOrderField appliesTo {
  principal: [User],
  resource: [Order],
  context: {
